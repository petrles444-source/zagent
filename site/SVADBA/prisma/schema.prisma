// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Rsvp {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  attending    String   @default("yes") // yes | no | maybe
  guests       Int      @default(1)
  meal         String?  // regular | vegetarian | vegan | kids
  drink        String?  // wine | champagne | strong | none
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Guestbook {
  id        String   @id @default(cuid())
  name      String
  message   String
  attend    String?  // yes | no | maybe
  likes      Int     @default(0)
  createdAt DateTime @default(now())
}

model SongRequest {
  id         String   @id @default(cuid())
  name       String
  title      String
  artist     String?
  nowPlaying Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model LoveLock {
  id        String   @id @default(cuid())
  initials  String
  message   String?
  color     String   @default("gold") // gold | blush | ivory | champagne
  createdAt DateTime @default(now())
}

model PhotoWall {
  id        String   @id @default(cuid())
  guestName String
  caption   String?
  image     String   // base64-encoded JPEG (client-resized to ≤900px)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GuestPoll {
  id        String   @id @default(cuid())
  answer    String   // yes | maybe | no
  createdAt DateTime @default(now())
}
