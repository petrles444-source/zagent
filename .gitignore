# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test / coverage
.pytest_cache/
pytest-of-*/
pytest-cache-files-*/
.tox/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Черновики и временные файлы
tmp/
*.tmp
*.bak
*.orig
*.rej
# Пробные задания стенда, если кто-то положит их в корень.
tmp*.yaml
# Каталоги, которые tempfile оставляет при падении теста или скрипта.
tmp*/
tmpv*/
tmp_*/
_tmp*/

# Результаты работы агента. Не в код: это то, что он создал по задачам, и
# один `git add .` закинул бы их в репозиторий вместе с исходниками.
projects/

# Папки замеров `check_agent_works.py`. По одной на модель, каждая со
# своей копией результата, и в гит они попадать не должны: их оставляют
# только ради разбора после `--keep`.
zagent-works-*/
probe-*/
dbg-*/

# Отчёты аудита: документы для чтения, не часть программы.
audit/

# Отчёты стенда: генерируются заново при каждом прогоне
reports/

# Notebooks
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp

# Environment / secrets
.env
.env.*
*.pem
*.key
config/secrets.local.json
secrets.local.json
# Реальные ключи в отдельном файле. В `.gitignore` его не было:
# `git status` показывал `config/keys.json` как новый файл с настоящими ключами, и
# `git add -A` отправил бы их в публичный репозиторий. Рядом — его пустая
# форма `config/keys.json.example`, его как раз легат пушить.
config/keys.json

# Logs / data
logs/
*.log
saves/
models/
data/
*.zip
*.rar

# Скриншоты, профили браузера и состояние агента
screenshots/
browser-profile/
web-state/

# OS
.DS_Store
Thumbs.db
desktop.ini
